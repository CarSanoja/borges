NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=
# Nebius Sandboxes (ConTree) reuse NEBIUS_API_KEY; the project id is on tokenfactory.nebius.com/project/api-keys.
NEBIUS_PROJECT_ID=
BORGES_LLM=scripted
BORGES_BACKEND=local
BORGES_SPEND_CAP_USD=5.00
BORGES_RUN_CAP_USD=0.50
BORGES_MAX_UNIVERSES=40
BORGES_CONCURRENCY=6
# Set true only on a private machine: lets uploaded datasets run live on the local backend (unsandboxed).
BORGES_ALLOW_UNTRUSTED_LOCAL=false
# Deprecated alias for an API key with uploads:write: a request with this value in X-Borges-Live-Token may upload.
# Prefer `borges keys create --name <n> --scopes uploads:write,runs:create:live:upload`.
BORGES_LIVE_TOKEN=
# true: the publisher of an agent version cannot approve it; approvals need a key with registry:approve.
BORGES_REGISTRY_FOUR_EYES=false
# HMAC key for the signed checkpoints of the global audit chain (tail truncation is detected against them).
BORGES_AUDIT_ANCHOR_KEY=
# Path of the gateway policy (default: policy/gateway.json in the repository).
# BORGES_GATEWAY_POLICY=policy/gateway.json
# true: ambiguous column notes and values are also classified by the judge model (off by default).
BORGES_ARMOR_LLM=false
